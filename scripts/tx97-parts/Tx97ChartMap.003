        },
      } as maplibregl.LayerSpecification);
      map.addLayer({
        id: LAYER_PORT_LABELS,
        type: "symbol",
        source: SOURCE_PORTS,
        layout: {
          visibility: showPortsRef.current ? "visible" : "none",
          "text-field": ["get", "name"],
          "text-size": 11,
          "text-offset": [0, 1.25],
          "text-anchor": "top",
        },
        paint: {
          "text-color": "#f4fbff",
          "text-halo-color": "rgba(2,10,20,0.9)",
          "text-halo-width": 1.2,
        },
      } as maplibregl.LayerSpecification);

      map.addSource(SOURCE_EVENTS, { type: "geojson", data: geoJsonData(emptyCollection()) });
      map.addLayer({
        id: LAYER_EVENTS,
        type: "circle",
        source: SOURCE_EVENTS,
        layout: { visibility: showEventsRef.current ? "visible" : "none" },
        paint: {
          "circle-radius": 9,
          "circle-color": [
            "match",
            ["get", "eventType"],
            "departure", "#bda0ff",
            "service_completed", "#bda0ff",
            "anchorage_entry", "#ffd780",
            "anchorage_exit", "#ffd780",
            "berth_assigned", "#8ddcff",
            "service_started", "#8ddcff",
            "#65e4cb",
          ],
          "circle-opacity": 0.74,
          "circle-stroke-color": "#ffffff",
          "circle-stroke-width": 1.2,
        },
      } as maplibregl.LayerSpecification);

      map.on("click", LAYER_CLUSTERS, async (event) => {
        const feature = event.features?.[0];
        const clusterId = feature?.properties?.cluster_id;
        if (clusterId === undefined || feature?.geometry.type !== "Point") return;
        const source = map.getSource(SOURCE_VESSELS) as maplibregl.GeoJSONSource | undefined;
        if (!source) return;
        const zoom = await source.getClusterExpansionZoom(Number(clusterId));
        map.easeTo({
          center: feature.geometry.coordinates as [number, number],
          zoom,
          duration: 600,
        });
      });
      map.on("click", LAYER_VESSELS, (event) => {
        const id = event.features?.[0]?.properties?.id;
        if (id) onSelectRef.current(String(id));
      });
      map.on("mouseenter", LAYER_VESSELS, (event) => {
        map.getCanvas().style.cursor = "pointer";
        const feature = event.features?.[0];
        if (!feature || feature.geometry.type !== "Point") return;
        popup
          .setLngLat(feature.geometry.coordinates as [number, number])
          .setDOMContent(popupContent((feature.properties ?? {}) as JsonProperties))
          .addTo(map);
      });
      map.on("mouseleave", LAYER_VESSELS, () => {
        map.getCanvas().style.cursor = "";
        popup.remove();
      });
      map.on("mouseenter", LAYER_CLUSTERS, () => { map.getCanvas().style.cursor = "pointer"; });
      map.on("mouseleave", LAYER_CLUSTERS, () => { map.getCanvas().style.cursor = ""; });

      baseStyleLoaded = true;
      setMapReady(true);
      setChartStatus({
        state: "ready",
        label: gatewayStatus.chartCollection || "Licensed TX-97 vector charts",
        detail: "TX-97 vector chart style and operational overlays loaded.",
      });
      updateViewport();
    });

    map.on("error", (event) => {
      if (baseStyleLoaded) {
        console.error("TX-97 chart resource error", event.error);
        return;
      }
      setChartStatus({
        state: "error",
        label: "TX-97 chart rendering error",
        detail: event.error?.message || "The licensed TX-97 chart style could not be rendered.",
      });
    });
    map.on("moveend", updateViewport);
    map.on("zoomend", updateViewport);

    return () => {
      popup.remove();
      map.remove();
      mapRef.current = null;
    };
  }, [gatewayStatus]);

  useEffect(() => {
    const map = mapRef.current;
    if (!map || !mapReady) return;
    setSourceData(map, SOURCE_VESSELS, vesselData);
    setSourceData(map, SOURCE_TRAILS, trailData);
    setSourceData(map, SOURCE_EVENTS, eventData);
    setVisibility(map, LAYER_PORTS, showPorts);
    setVisibility(map, LAYER_PORT_LABELS, showPorts);
    setVisibility(map, LAYER_EVENTS, showEvents);
    setVisibility(map, LAYER_TRAILS, showTrails);

    if (!autoFitCompleted.current && vessels.length > 0) {
      fitCoordinates(map, vesselCoordinates(vessels), expanded);
      autoFitCompleted.current = true;
    }

    const bounds = map.getBounds();
    const inView = vessels.filter((vessel) => (
      hasCoordinates(vessel) && bounds.contains([vessel.longitude, vessel.latitude])
    )).length;
    onViewportRef.current?.({ inView, zoom: map.getZoom() });
  }, [eventData, expanded, mapReady, showEvents, showPorts, showTrails, trailData, vesselData, vessels]);

  useEffect(() => {
    const map = mapRef.current;
    if (!map || !mapReady) return;
    map.setFilter(LAYER_SELECTED, ["==", ["get", "id"], selectedVesselId || "__none__"]);
    if (!selectedVesselId || selectedRef.current === selectedVesselId) return;
    selectedRef.current = selectedVesselId;
    const selected = vessels.find((vessel) => vessel.id === selectedVesselId);
    if (!selected || !hasCoordinates(selected)) return;
    map.easeTo({
      center: [selected.longitude, selected.latitude],
      zoom: Math.max(map.getZoom(), 8),
      duration: 600,
    });
  }, [mapReady, selectedVesselId, vessels]);

  useImperativeHandle(forwardedRef, () => ({
    zoomIn: () => { mapRef.current?.zoomIn({ duration: 250 }); },
    zoomOut: () => { mapRef.current?.zoomOut({ duration: 250 }); },
    fitWorld: () => {
      mapRef.current?.easeTo({
        center: [WORLD_CENTER.lon, WORLD_CENTER.lat],
        zoom: 1.7,
        bearing: 0,
        pitch: 0,
        duration: 750,
      });
    },
    fitPorts: () => {
      const map = mapRef.current;
      if (map) fitCoordinates(map, portCoordinates(), expanded, 8);
    },
    fitVessels: () => {
      const map = mapRef.current;
      if (map) fitCoordinates(map, vesselCoordinates(vesselsRef.current), expanded);
    },
    centerOnVessel: (vesselId: string) => {
      const map = mapRef.current;
      const vessel = vesselsRef.current.find((row) => row.id === vesselId);
      if (!map || !vessel || !hasCoordinates(vessel)) return;
      map.easeTo({
        center: [vessel.longitude, vessel.latitude],
        zoom: Math.max(map.getZoom(), 8),
        duration: 600,
      });
    },
  }), [expanded]);

  return (
    <div className="tx97-chart-host" data-chart-state={chartStatus.state}>
      <div
        ref={containerRef}
        className="tx97-chart-canvas"
        role="application"
        aria-label="Licensed TX-97 vector chart with AIS vessel overlays"
      />
      {chartStatus.state !== "ready" && (
        <div className="tx97-chart-state" role="status" aria-live="polite">
          <span className="tx97-chart-state-kicker">Wärtsilä TX-97</span>
          <strong>{chartStatus.label}</strong>
          <p>{chartStatus.detail}</p>
          <small>
            The application does not fall back to OpenStreetMap or a fixed basemap.
            A licensed, authorized TX-97 chart service is required.
          </small>
        </div>
      )}
      <div className="tx97-chart-warning">
        TX-97 decision-support display · not an ECDIS or navigational substitute
      </div>
    </div>
  );
});

export default Tx97ChartMap;
