import {
  forwardRef,
  useEffect,
  useImperativeHandle,
  useMemo,
  useRef,
  useState,
} from "react";
import * as maplibregl from "maplibre-gl";
import type { Vessel } from "@/data/chmarlData";
import type { PortEvent } from "@/types/chmarl";

type GeoPoint = { lat: number; lon: number };
type JsonProperties = Record<string, string | number | boolean | null>;
type PointFeature = {
  type: "Feature";
  id?: string | number;
  properties: JsonProperties;
  geometry: { type: "Point"; coordinates: [number, number] };
};
type LineFeature = {
  type: "Feature";
  id?: string | number;
  properties: JsonProperties;
  geometry: { type: "LineString"; coordinates: [number, number][] };
};
type FeatureCollection = {
  type: "FeatureCollection";
  features: Array<PointFeature | LineFeature>;
};

export type Tx97ChartStatus = {
  state: "checking" | "ready" | "unconfigured" | "restricted" | "error";
  label: string;
  detail: string;
};

export type Tx97ViewportStats = {
  inView: number;
  zoom: number;
};

export type Tx97ChartMapHandle = {
  zoomIn: () => void;
  zoomOut: () => void;
  fitWorld: () => void;
  fitPorts: () => void;
  fitVessels: () => void;
  centerOnVessel: (vesselId: string) => void;
};

type GatewayStatus = {
  provider?: string;
  chartCollection?: string;
  configured?: boolean;
  publicDisplayAuthorized?: boolean;
  ready?: boolean;
  reason?: string | null;
};

type Props = {
  vessels: Vessel[];
  portEvents: PortEvent[];
  showPorts: boolean;
  showEvents: boolean;
  showTrails: boolean;
  selectedVesselId: string;
  expanded?: boolean;
  onSelectVessel: (vesselId: string) => void;
  onStatusChange?: (status: Tx97ChartStatus) => void;
  onViewportChange?: (stats: Tx97ViewportStats) => void;
};

const STATUS_URL = "/api/charts/tx97/status";
const STYLE_URL = "/api/charts/tx97/style.json";
const PORTS_CENTER: GeoPoint = { lat: 23.2, lon: 43.5 };
const WORLD_CENTER: GeoPoint = { lat: 18, lon: 5 };

const SOURCE_VESSELS = "chmarl-vessels";
const LAYER_CLUSTERS = "chmarl-vessel-clusters";
const LAYER_CLUSTER_COUNT = "chmarl-vessel-cluster-count";
const LAYER_SELECTED = "chmarl-vessel-selected";
const LAYER_VESSELS = "chmarl-vessel-points";
const SOURCE_TRAILS = "chmarl-vessel-trails";
const LAYER_TRAILS = "chmarl-vessel-trail-lines";
const SOURCE_PORTS = "chmarl-ports";
const LAYER_PORTS = "chmarl-port-points";
const LAYER_PORT_LABELS = "chmarl-port-labels";
const SOURCE_EVENTS = "chmarl-port-events";
const LAYER_EVENTS = "chmarl-port-event-points";

const portGeo: Record<string, GeoPoint> = {
  Jeddah: { lat: 21.4858, lon: 39.1925 },
  "King Abdullah Port": { lat: 22.3924, lon: 39.0953 },
  Yanbu: { lat: 24.0866, lon: 38.0637 },
  Suez: { lat: 29.9668, lon: 32.5498 },
  Dammam: { lat: 26.4318, lon: 50.1015 },
  "Jebel Ali": { lat: 25.0114, lon: 55.0611 },
  Jizan: { lat: 16.8917, lon: 42.5511 },
};

function hasCoordinates(vessel: Vessel): vessel is Vessel & { latitude: number; longitude: number } {
  return typeof vessel.latitude === "number"
    && Number.isFinite(vessel.latitude)
    && vessel.latitude >= -85.051129
    && vessel.latitude <= 85.051129
    && typeof vessel.longitude === "number"
    && Number.isFinite(vessel.longitude)
    && vessel.longitude >= -180
    && vessel.longitude <= 180;
}

function emptyCollection(): FeatureCollection {
  return { type: "FeatureCollection", features: [] };
}

function vesselCollection(vessels: Vessel[]): FeatureCollection {
  return {
    type: "FeatureCollection",
    features: vessels.filter(hasCoordinates).map((vessel) => ({
      type: "Feature",
      id: vessel.id,
      properties: {
        id: vessel.id,
        name: vessel.name,
        route: vessel.route,
        cargo: vessel.cargo,
        eta: vessel.eta,
        speed: vessel.speed,
        status: vessel.status,
        timestamp: vessel.timestamp ?? "",
        inputSource: vessel.inputSource ?? "",
      },
      geometry: { type: "Point", coordinates: [vessel.longitude, vessel.latitude] },
    })),
  };
}

function trailCollection(vessels: Vessel[]): FeatureCollection {
  const features: LineFeature[] = [];
  for (const vessel of vessels) {
    const coordinates = vessel.trail
      ?.filter((point) => (
        Number.isFinite(point.latitude)
        && Number.isFinite(point.longitude)
        && point.latitude >= -85.051129
        && point.latitude <= 85.051129
        && point.longitude >= -180
        && point.longitude <= 180
      ))
      .map((point) => [point.longitude, point.latitude] as [number, number]);
    if (!coordinates || coordinates.length < 2) continue;
    features.push({
      type: "Feature",
      id: `${vessel.id}-trail`,
      properties: { id: vessel.id, status: vessel.status },
      geometry: { type: "LineString", coordinates },
    });
  }
  return { type: "FeatureCollection", features };
}

function portCollection(): FeatureCollection {
  return {
    type: "FeatureCollection",
    features: Object.entries(portGeo).map(([name, point]) => ({
      type: "Feature",
      id: name,
      properties: { id: name, name },
      geometry: { type: "Point", coordinates: [point.lon, point.lat] },
    })),
  };
}

function eventCollection(events: PortEvent[]): FeatureCollection {
  const features: PointFeature[] = [];
  for (const event of events) {
    const point = portGeo[event.portId];
    if (!point) continue;
    features.push({
      type: "Feature",
      id: event.eventId,
      properties: {
        id: event.eventId,
        portId: event.portId,
        eventType: event.eventType,
        timestamp: event.timestamp,
      },
      geometry: { type: "Point", coordinates: [point.lon, point.lat] },
    });
  }
  return { type: "FeatureCollection", features };
}

function geoJsonData(value: FeatureCollection) {
  return value as Parameters<maplibregl.GeoJSONSource["setData"]>[0];
}

function setSourceData(map: maplibregl.Map, sourceId: string, value: FeatureCollection) {
  const source = map.getSource(sourceId) as maplibregl.GeoJSONSource | undefined;
  source?.setData(geoJsonData(value));
}

function setVisibility(map: maplibregl.Map, layerId: string, visible: boolean) {
  if (map.getLayer(layerId)) {
    map.setLayoutProperty(layerId, "visibility", visible ? "visible" : "none");
  }
}

function vesselCoordinates(vessels: Vessel[]) {
  return vessels
    .filter(hasCoordinates)
    .map((vessel) => [vessel.longitude, vessel.latitude] as [number, number]);
}

function portCoordinates() {
  return Object.values(portGeo).map((point) => [point.lon, point.lat] as [number, number]);
}

function fitCoordinates(
  map: maplibregl.Map,
  coordinates: [number, number][],
  expanded: boolean,
  maxZoom = 10,
) {
  if (coordinates.length === 0) return;
  if (coordinates.length === 1) {
    map.easeTo({ center: coordinates[0], zoom: Math.max(map.getZoom(), 8), duration: 650 });
    return;
  }
  const bounds = coordinates.slice(1).reduce(
    (current, coordinate) => current.extend(coordinate),
    new maplibregl.LngLatBounds(coordinates[0], coordinates[0]),
  );
  map.fitBounds(bounds, {
    padding: { top: 88, bottom: 56, left: 46, right: expanded ? 372 : 46 },
    maxZoom,
    duration: 800,
  });
}
